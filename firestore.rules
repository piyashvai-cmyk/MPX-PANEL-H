rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // License Keys Collection (Keys generated by admin, validated by users)
    match /license_keys/{keyId} {
      // Users can read a specific key to validate/login
      allow get: if true;
      // Users can update key usage (bind their hardware device ID) if active and under device limit
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedByDeviceId', 'activatedAt', 'expiresAt'])
                    && resource.data.isActive == true;
      // Only admin can list all keys, create keys, toggle ban status, or delete keys
      allow list, create, delete: if request.auth != null;
    }
    
    // Admin & Server Remote Configuration (Server Status, Notice, Maintenance, Force Update)
    match /server_config/{configId} {
      // Anyone using the app can read server configuration (server online status, announcements, force update)
      allow read: if true;
      // Only authenticated admin can update server configurations
      allow write: if request.auth != null;
    }

    // Banned Devices Collection (Global blacklist)
    match /banned_devices/{deviceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
